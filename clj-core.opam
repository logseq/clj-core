# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Clojure-style data structures and core API for OCaml"
description:
  "clj-core ports the daily-use surface of clojure.core to OCaml: persistent vectors (backed by rrbvec), sorted maps and sets, lists, lazy sequences, queues, atoms, delays, keywords, and function combinators. Names follow the lg munging convention: ? -> _, ! -> _bang, - -> _."
maintainer: ["Tienson Qin <tiensonqin@gmail.com>"]
authors: ["Tienson Qin <tiensonqin@gmail.com>"]
license: "MIT"
homepage: "https://github.com/logseq/clj-core"
doc: "https://github.com/logseq/clj-core"
bug-reports: "https://github.com/logseq/clj-core/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.23"}
  "rrbvec"
  "melange"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/logseq/clj-core.git"
x-maintenance-intent: ["(latest)"]
pin-depends: [
  ["rrbvec.dev" "git+https://github.com/logseq/rrbvec.git#main"]
]
